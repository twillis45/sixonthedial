# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bulk dictionary source for scripts/build-definitions.mjs (22MB).
# Regenerate: curl -sL https://raw.githubusercontent.com/matthewreagan/WebstersEnglishDictionary/master/dictionary_compact.json -o data/webster.json
data/webster.json

# Review-board render artifacts — regenerate with scripts/capture-review.mjs
review-artifacts/
data/wordnet.json

# Marketing stills — regenerated, not stored.
#
# 60 PNGs at 39MB, reproducible in about two minutes:
#   npm run build && npx serve -s out -l 4310
#   node scripts/capture-marketing.mjs http://localhost:4310
#
# The SCRIPT is the artifact. It is deterministic and it refuses to finish if
# any still is not the look it claims to be — the first run caught ten frames
# labelled "Signal green" that were actually matte orange, because the shipped
# default is matte and an absent accent key resolves to it.
#
# The hand-composited mockup-*.png files in the same folder are NOT ignored:
# there is no generator for those, so git is the only place they exist.
/store/marketing/*.png
!/store/marketing/mockup-*.png
!/store/marketing/flat-*.png
# Campaign clips — rebuilt by capture-video.mjs from the shipped build.
/store/video/
/store/marketing/manifest.json

# ── Android / TWA signing material ────────────────────────────────────────
# This repo is PUBLIC. An upload keystore in git history cannot be un-published,
# and it is the one artifact that cannot be regenerated — losing it or leaking
# it are both unrecoverable in different directions. Ignored before the Android
# project exists, so there is no window where a keystore is trackable.
*.keystore
*.jks
*.p12
android/node_modules/
android/keystore*
android/**/local.properties
android/.gradle/
android/build/
android/app/build/

# Bubblewrap writes release artifacts to the android/ root, not android/build/,
# so the build/ rules above miss them. Caught by `git status` after the first
# successful `bubblewrap build`, with a 1 MB signed APK sitting untracked.
android/app-release-*.apk
android/app-release-*.aab
android/app-release-*.idsig
